#: src/Admin/Sentences.php:125
msgid "The file did not arrive whole. Choose it again."
msgstr "Le fichier n’est pas arrivé en entier. Choisissez-le de nouveau."

#: src/Admin/Sentences.php:126
msgid "That is not a .csv file. Save the sheet as CSV and choose it again."
msgstr "Ce n’est pas un fichier .csv. Enregistrez la feuille en CSV et choisissez-la de nouveau."

#: src/Admin/Sentences.php:127
msgid "The file is over 2 MB. Split it into smaller files."
msgstr "Le fichier dépasse 2 Mo. Divisez-le en fichiers plus petits."

#: src/Admin/Sentences.php:128
msgid "The file is not saved as UTF-8. Save it as CSV UTF-8 and choose it again."
msgstr "Le fichier n’est pas enregistré en UTF-8. Enregistrez-le en CSV UTF-8 et choisissez-le de nouveau."

#: src/Admin/Sentences.php:129
msgid "The file has no rows under its headings."
msgstr "Le fichier n’a aucune ligne sous ses en-têtes."

#: src/Admin/Sentences.php:130
msgid "The file has more than 5,000 rows. Split it into smaller files."
msgstr "Le fichier compte plus de 5 000 lignes. Divisez-le en fichiers plus petits."

#: src/Admin/Sentences.php:131
msgid "The file has no column for what parts are matched by. Add an id or a sku column, or change the choice below."
msgstr "Le fichier n’a pas de colonne qui sert à associer les pièces. Ajoutez une colonne id ou sku, ou changez le choix ci-dessous."

#: src/Admin/Sentences.php:132
msgid "A column is in the file twice. Keep one of each."
msgstr "Une colonne figure deux fois dans le fichier. Gardez-en une de chaque."

#: src/Admin/Sentences.php:133
msgid "The file has no spec columns, so there is nothing to import."
msgstr "Le fichier n’a aucune colonne de caractéristiques, donc il n’y a rien à importer."

#: src/Admin/Sentences.php:134
msgid "An import is running. Wait for it to finish."
msgstr "Une importation est en cours. Attendez qu’elle se termine."

#: src/Admin/Sentences.php:162
msgid "The row does not say which part it is for."
msgstr "La ligne n’indique pas à quelle pièce elle s’applique."

#. translators: %s: an ID or a SKU.
#: src/Admin/Sentences.php:164
#, php-format
msgid "\"%s\" is in the file more than once. Keep one row for it."
msgstr "« %s » figure plus d’une fois dans le fichier. Gardez une seule ligne pour cette valeur."

#. translators: %s: an ID or a SKU.
#: src/Admin/Sentences.php:166
#, php-format
msgid "No product is \"%s\"."
msgstr "Aucun produit ne correspond à « %s »."

#. translators: %s: a SKU.
#: src/Admin/Sentences.php:168
#, php-format
msgid "The product with this ID does not have the SKU \"%s\". Check the row is for this shop, or match parts by SKU."
msgstr "Le produit qui a cet ID n’a pas l’UGS « %s ». Vérifiez que la ligne est bien pour ce magasin, ou associez les pièces par UGS."

#. translators: %s: a chart's name.
#: src/Admin/Sentences.php:170
#, php-format
msgid "There is no chart named \"%s\". Add it under Spec tables first."
msgstr "Aucun tableau ne s’appelle « %s ». Ajoutez-le d’abord sous Tableaux de caractéristiques."

#. translators: %s: a chart's name.
#: src/Admin/Sentences.php:172
#, php-format
msgid "More than one chart is named \"%s\". Rename one under Spec tables."
msgstr "Plus d’un tableau s’appelle « %s ». Renommez-en un sous Tableaux de caractéristiques."

#. translators: %s: a size in a chart.
#: src/Admin/Sentences.php:174
#, php-format
msgid "The chart has no size \"%s\"."
msgstr "Le tableau n’a pas de taille « %s »."

#: src/Admin/Sentences.php:175
#: src/Admin/SpecTablesScreen.php:336
msgid "The size is too long. Use 40 characters or fewer."
msgstr "La taille est trop longue. Utilisez 40 caractères ou moins."

#. translators: 1: a deck's width with its unit, such as 8.6 in. 2: another, such as 8.375 in.
#: src/Admin/Sentences.php:177
#, php-format
msgid "The narrowest deck, %1$s, is wider than the widest deck, %2$s."
msgstr "La planche la plus étroite, %1$s, est plus large que la planche la plus large, %2$s."

#: src/Admin/Sentences.php:178
#: src/Admin/SpecTablesScreen.php:319
#: src/Admin/SpecTablesScreen.php:334
msgid "That chart is no longer there."
msgstr "Ce tableau n’existe plus."

#. translators: %s: what a cell held.
#: src/Admin/Sentences.php:180
#, php-format
msgid "\"%s\" is not a measurement. Use a number, or a fraction such as 8 1/4."
msgstr "« %s » n’est pas une mesure. Utilisez un nombre, ou une fraction comme 8 1/4."

#. translators: %s: what a cell held.
#: src/Admin/Sentences.php:182
#, php-format
msgid "The fraction in \"%s\" divides by zero."
msgstr "La fraction dans « %s » divise par zéro."

#. translators: %s: what a cell held.
#: src/Admin/Sentences.php:184
#, php-format
msgid "\"%s\" is below zero."
msgstr "« %s » est inférieur à zéro."

#. translators: %s: what a cell held.
#: src/Admin/Sentences.php:186
#, php-format
msgid "\"%s\" is not a value this column takes."
msgstr "« %s » n’est pas une valeur que cette colonne accepte."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:235
#, php-format
msgid "%s: fill this in."
msgstr "%s : remplissez ce champ."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:237
#, php-format
msgid "%s: type a number, such as 0.25."
msgstr "%s : tapez un nombre, comme 0.25."

#. translators: 1: a field's name. 2: the most units a slot takes. 3: the most slots a kit takes. 4: the most presets a kit takes.
#: src/Admin/Sentences.php:239
#, php-format
msgid "%1$s: this is more than the kit takes, or less. A slot takes 1 to %2$d units, a kit %3$d slots and %4$d presets, and text no more than its field allows."
msgstr "%1$s : c’est plus ou moins que ce que l’ensemble accepte. Un emplacement accepte de 1 à %2$d unités, un ensemble %3$d emplacements et %4$d modèles prêts, et un texte pas plus long que ce que son champ permet."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:241
#, php-format
msgid "%s: the kit already has a slot of this kind. A kit takes one of each."
msgstr "%s : l’ensemble a déjà un emplacement de ce type. Un ensemble en accepte un de chaque type."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:243
#, php-format
msgid "%s: the deck's slot must come first, since every other part is checked against the deck. Move it up."
msgstr "%s : l’emplacement de la planche doit venir en premier, car chaque autre pièce est vérifiée par rapport à la planche. Déplacez-le vers le haut."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:245
#, php-format
msgid "%s: the risers' slot must come before the hardware's, since the bolts' length depends on the riser. Move it up."
msgstr "%s : l’emplacement des risers doit venir avant celui de la quincaillerie, car la longueur des boulons dépend du riser. Déplacez-le vers le haut."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:247
#, php-format
msgid "%s: this must not be less than the figure before it."
msgstr "%s : ce chiffre ne doit pas être inférieur au précédent."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:249
#, php-format
msgid "%s: the kit has no such slot now. Clear the part, or keep the slot."
msgstr "%s : l’ensemble n’a plus cet emplacement. Retirez la pièce, ou gardez l’emplacement."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:251
#, php-format
msgid "%s: choose a part. A build must have one."
msgstr "%s : choisissez une pièce. Un montage doit en avoir une."

#: src/Admin/Sentences.php:252
msgid "The slots were not saved. A preset the kit already has names a slot these leave out, or leaves empty one a build must now have. Put that preset right, or remove it, in the same save."
msgstr "Les emplacements n’ont pas été enregistrés. Un modèle prêt de l’ensemble nomme un emplacement qui n’y figure plus, ou laisse vide un emplacement qu’un montage doit maintenant avoir. Corrigez ce modèle prêt, ou retirez-le, dans le même enregistrement."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:254
#, php-format
msgid "%s: type a wheelbase from 10 to 20 in, or leave it empty."
msgstr "%s : tapez un empattement de 10 à 20 po, ou laissez le champ vide."

#: src/Admin/Sentences.php:267
msgid "Presets need the kit's slots. Put the slots right and save, then add the presets."
msgstr "Les modèles prêts ont besoin des emplacements de l’ensemble. Corrigez les emplacements et enregistrez, puis ajoutez les modèles prêts."

#. translators: 1: a field's name. 2: a product's name. 3: a slot's label.
#: src/Admin/Sentences.php:269
#, php-format
msgid "%1$s: %2$s is not a part the %3$s slot takes, or it cannot be bought now."
msgstr "%1$s : %2$s n’est pas une pièce que l’emplacement %3$s accepte, ou elle ne peut pas être achetée en ce moment."

#. translators: 1: a field's name. 2: a product's name. 3: a rule's number, such as R1.
#: src/Admin/Sentences.php:272
#, php-format
msgid "%1$s: %2$s lacks a spec that rule %3$s reads, so the builder does not offer it. Fill it in on its Part specs."
msgstr "%1$s : il manque à %2$s une caractéristique que la règle %3$s lit, donc le configurateur ne la propose pas. Remplissez-la dans ses caractéristiques de pièce."

#. translators: 1: a field's name. 2: a product's name. 3: a rule's number, such as R1. 4: a preset's name.
#: src/Admin/Sentences.php:274
#, php-format
msgid "%1$s: %2$s does not fit the other parts of \"%4$s\". Rule %3$s does not let them go together."
msgstr "%1$s : %2$s n’est pas compatible avec les autres pièces de « %4$s ». La règle %3$s ne permet pas de les assembler."

#. translators: %s: a field's name.
#: src/Admin/Sentences.php:276
#, php-format
msgid "%s: this is not a value the field takes."
msgstr "%s : ce n’est pas une valeur que ce champ accepte."

#. translators: %s: a section's name.
#: src/Admin/Sentences.php:278
#, php-format
msgid "%s: what was sent could not be read. Load the page again and try once more."
msgstr "%s : ce qui a été envoyé n’a pas pu être lu. Rechargez la page et réessayez."

#: src/Admin/SettingsPage.php:97
msgid "Where the builder reads each part's specs. Saving a change here reads every part again, in the background."
msgstr "L’endroit où le configurateur lit les caractéristiques de chaque pièce. Enregistrer une modification ici relit toutes les pièces, en arrière-plan."

#: src/Admin/SettingsPage.php:113
msgid "Builds"
msgstr "Montages"

#: src/Admin/SettingsPage.php:115
msgid "What every build is sold on."
msgstr "Les conditions de vente de chaque montage."

#: src/Admin/SettingsPage.php:128
msgid "Visitors"
msgstr "Visiteurs"

#: src/Admin/SettingsPage.php:130
msgid "The builder asks the shop for prices and stock as a visitor picks parts. The limit keeps one address from asking too often. The address is never stored: a scrambled form of it is kept for the minute it is counted in."
msgstr "Le configurateur demande au magasin les prix et les stocks pendant qu’un visiteur choisit ses pièces. La limite empêche une même adresse de faire trop de demandes. L’adresse n’est jamais enregistrée : une forme brouillée en est gardée pendant la minute où elle est comptée."

#: src/Admin/SettingsPage.php:143
msgid "New kits"
msgstr "Nouveaux ensembles"

#: src/Admin/SettingsPage.php:145
msgid "What the assembly settings of a new kit start from. A kit that is already set up keeps its own."
msgstr "Le point de départ des réglages d’assemblage d’un nouvel ensemble. Un ensemble déjà configuré garde les siens."

#: src/Admin/SettingsPage.php:201
#: src/Health/SiteHealth.php:383
msgid "Build discount (%)"
msgstr "Rabais sur le montage (%)"

#: src/Admin/SettingsPage.php:204
msgid "A percentage taken off each part of a build. 0 for none. Below 100, with up to two decimals."
msgstr "Un pourcentage retiré du prix de chaque pièce d’un montage. 0 pour aucun. Moins de 100, avec jusqu’à deux décimales."

#: src/Admin/SettingsPage.php:209
#: src/Health/SiteHealth.php:387
msgid "A fixed product discount coupon applies to"
msgstr "Un code promo de remise fixe sur produit s’applique à"

#: src/Admin/SettingsPage.php:212
msgid "A coupon that takes a fixed amount off a product, where the kit is one of its products. On every part, the amount comes off each part of the build as well."
msgstr "Un code promo qui retire un montant fixe du prix d’un produit, quand l’ensemble fait partie de ses produits. Avec « L’ensemble et chaque pièce », le montant est aussi retiré de chaque pièce du montage."

#: src/Admin/SettingsPage.php:214
#: src/Health/SiteHealth.php:388
msgid "The kit alone"
msgstr "L’ensemble seulement"

#: src/Admin/SettingsPage.php:215
#: src/Health/SiteHealth.php:388
msgid "The kit and every part"
msgstr "L’ensemble et chaque pièce"

#: src/Admin/SettingsPage.php:220
#: src/Health/SiteHealth.php:392
msgid "Requests a minute from one address"
msgstr "Demandes par minute d’une même adresse"

#: src/Admin/SettingsPage.php:223
msgid "A whole number from 10 to 6000. An address that asks more often is told to wait until its minute ends."
msgstr "Un nombre entier de 10 à 6000. Une adresse qui fait plus de demandes doit attendre la fin de sa minute."

#: src/Admin/SettingsPage.php:229
#: src/Health/SiteHealth.php:397
msgid "Trusted proxy header"
msgstr "En-tête de proxy de confiance"

#: src/Admin/SettingsPage.php:232
msgid "Leave this empty unless the shop is behind a proxy or a content delivery network that puts the visitor's address in a request header, such as X-Forwarded-For. Name the header only when every request passes through that proxy: a visitor who can send the header themselves can get past the limit."
msgstr "Laissez ce champ vide sauf si le magasin est derrière un proxy ou un réseau de diffusion de contenu qui place l’adresse du visiteur dans un en-tête de requête, comme X-Forwarded-For. Nommez l’en-tête seulement si chaque requête passe par ce proxy : un visiteur qui peut envoyer l’en-tête lui-même peut contourner la limite."

#: src/Admin/SettingsPage.php:355
msgid "First"
msgstr "Première"

#: src/Admin/SettingsPage.php:356
msgid "Second"
msgstr "Deuxième"

#: src/Admin/SettingsPage.php:357
msgid "Third"
msgstr "Troisième"

#: src/Admin/SettingsPage.php:403
msgid "The settings were not saved. Each problem is shown beside its field."
msgstr "Les réglages n’ont pas été enregistrés. Chaque problème est indiqué à côté de son champ."

#: src/Admin/SettingsPage.php:431
msgid "Choose the attribute this spec is read from, or clear the line."
msgstr "Choisissez l’attribut d’où cette caractéristique est lue, ou effacez la ligne."

#: src/Admin/SettingsPage.php:432
msgid "Choose the spec this attribute feeds, or clear the line."
msgstr "Choisissez la caractéristique que cet attribut alimente, ou effacez la ligne."

#: src/Admin/SettingsPage.php:433
msgid "The attribute's name is too long. Use 190 characters or fewer."
msgstr "Le nom de l’attribut est trop long. Utilisez 190 caractères ou moins."

#: src/Admin/SettingsPage.php:434
msgid "Choose a spec from the list."
msgstr "Choisissez une caractéristique dans la liste."

#: src/Admin/SettingsPage.php:435
msgid "Choose a unit from the list."
msgstr "Choisissez une unité dans la liste."

#: src/Admin/SettingsPage.php:436
msgid "This spec is not a length, so it has no unit. Set the unit to the spec's own."
msgstr "Cette caractéristique n’est pas une longueur, donc elle n’a pas d’unité. Réglez l’unité sur celle de la caractéristique."

#: src/Admin/SettingsPage.php:437
msgid "This attribute already feeds this spec on a line above. Clear one of the two."
msgstr "Cet attribut alimente déjà cette caractéristique sur une ligne plus haut. Effacez l’une des deux."

#: src/Admin/SettingsPage.php:438
msgid "The mapping holds 50 lines at most. Clear some lines."
msgstr "La correspondance contient 50 lignes au plus. Effacez des lignes."

#: src/Admin/SettingsPage.php:439
msgid "Put each source in one place: first, second and third."
msgstr "Placez chaque source à un seul rang : première, deuxième et troisième."

#: src/Admin/SettingsPage.php:440
msgid "Enter a percentage below 100 with up to two decimals, or 0 for none."
msgstr "Entrez un pourcentage inférieur à 100 avec jusqu’à deux décimales, ou 0 pour aucun."

#: src/Admin/SettingsPage.php:441
msgid "Choose where the coupon applies from the list."
msgstr "Choisissez dans la liste où le code promo s’applique."

#: src/Admin/SettingsPage.php:442
msgid "Enter a whole number from 10 to 6000."
msgstr "Entrez un nombre entier de 10 à 6000."

#: src/Admin/SettingsPage.php:443
msgid "Enter the header's name alone, such as X-Forwarded-For: letters, digits and hyphens, starting with a letter, 64 characters at most."
msgstr "Entrez seulement le nom de l’en-tête, comme X-Forwarded-For : des lettres, des chiffres et des traits d’union, en commençant par une lettre, 64 caractères au plus."

#: src/Admin/SettingsPage.php:444
msgid "Enter an amount with up to four decimals, or 0 for none."
msgstr "Entrez un montant avec jusqu’à quatre décimales, ou 0 pour aucun."

#: src/Admin/SettingsPage.php:445
msgid "The lead time is too long. Use 200 characters or fewer."
msgstr "Le texte du délai est trop long. Utilisez 200 caractères ou moins."

#: src/Admin/SettingsPage.php:446
msgid "The returns notice is too long. Use 1,000 characters or fewer."
msgstr "L’avis sur les retours est trop long. Utilisez 1 000 caractères ou moins."

#: src/Admin/SpecTablesScreen.php:193
msgid "Nothing was saved. Each problem is shown with the field it is about."
msgstr "Rien n’a été enregistré. Chaque problème est indiqué avec le champ qu’il concerne."

#: src/Admin/SpecTablesScreen.php:316
msgid "The chart was added. Give it a row for each size."
msgstr "Le tableau a été ajouté. Donnez-lui une ligne pour chaque taille."

#: src/Admin/SpecTablesScreen.php:317
msgid "The chart was saved. Every part is being read again, in the background."
msgstr "Le tableau a été enregistré. Toutes les pièces sont relues, en arrière-plan."

#: src/Admin/SpecTablesScreen.php:318
msgid "The chart was deleted."
msgstr "Le tableau a été supprimé."

#: src/Admin/SpecTablesScreen.php:331
msgid "Type the maker's name."
msgstr "Tapez le nom du fabricant."

#: src/Admin/SpecTablesScreen.php:332
msgid "The maker's name is too long. Use 190 characters or fewer."
msgstr "Le nom du fabricant est trop long. Utilisez 190 caractères ou moins."

#: src/Admin/SpecTablesScreen.php:333
msgid "Another chart has this name. Give this one a name of its own."
msgstr "Un autre tableau porte ce nom. Donnez à celui-ci un nom qui lui est propre."

#: src/Admin/SpecTablesScreen.php:335
msgid "Type the size this row is for, or clear the row."
msgstr "Tapez la taille de cette ligne, ou effacez la ligne."

#: src/Admin/SpecTablesScreen.php:337
msgid "This size is on a row above. Clear one of the two."
msgstr "Cette taille figure sur une ligne plus haut. Effacez l’une des deux."

#: src/Admin/SpecTablesScreen.php:338
msgid "The source is too long. Use 200 characters or fewer."
msgstr "La source est trop longue. Utilisez 200 caractères ou moins."

#: src/Admin/SpecTablesScreen.php:339
msgid "The day it was read is not a date. Choose one, or clear it."
msgstr "Le jour de la lecture n’est pas une date. Choisissez-en une, ou effacez le champ."

#: src/Admin/SpecTablesScreen.php:340
msgid "A chart holds 100 sizes at most. Clear some rows."
msgstr "Un tableau contient 100 tailles au plus. Effacez des lignes."

#: src/Admin/SpecTablesScreen.php:354
msgid "The narrowest deck is wider than the widest deck. Check the two figures on this row."
msgstr "La planche la plus étroite est plus large que la planche la plus large. Vérifiez les deux chiffres de cette ligne."

#. translators: 1: a spec's name. 2: what was typed.
#: src/Admin/SpecTablesScreen.php:356
#, php-format
msgid "%1$s: \"%2$s\" is not a measurement. Type a number, or a fraction such as 8 1/4."
msgstr "%1$s : « %2$s » n’est pas une mesure. Tapez un nombre, ou une fraction comme 8 1/4."

#. translators: 1: a spec's name. 2: what was typed.
#: src/Admin/SpecTablesScreen.php:358
#, php-format
msgid "%1$s: the fraction in \"%2$s\" divides by zero."
msgstr "%1$s : la fraction dans « %2$s » divise par zéro."

#. translators: 1: a spec's name. 2: what was typed.
#: src/Admin/SpecTablesScreen.php:360
#, php-format
msgid "%1$s: \"%2$s\" is below zero."
msgstr "%1$s : « %2$s » est inférieur à zéro."

#. translators: 1: a spec's name. 2: what was typed.
#: src/Admin/SpecTablesScreen.php:362
#, php-format
msgid "%1$s: \"%2$s\" is not a value it takes."
msgstr "%1$s : « %2$s » n’est pas une valeur acceptée."

#: src/Cart/AgainHooks.php:168
msgid "A build from that order cannot be bought as it was, so none of it was added. Build it again to order it."
msgstr "Un montage de cette commande ne peut pas être acheté tel quel, donc aucune de ses pièces n’a été ajoutée. Refaites le montage pour le commander."

#. translators: %s: a kit's name, such as Build a complete.
#: src/Cart/Refusals.php:76
#, php-format
msgid "%s is no longer sold. Remove it from your cart to check out."
msgstr "%s : cet article n’est plus en vente. Retirez-le de votre panier pour passer la commande."

#. translators: %s: a kit's name, such as Build a complete.
#: src/Cart/Refusals.php:78
#, php-format
msgid "%s cannot be bought as it is now. Remove it from your cart to check out."
msgstr "%s : cet article ne peut pas être acheté dans son état actuel. Retirez-le de votre panier pour passer la commande."

#. translators: %s: a kit's name, such as Build a complete.
#: src/Cart/Refusals.php:82
#, php-format
msgid "%s cannot be bought as it is now. Remove it from your cart to check out, then build it again."
msgstr "%s : cet article ne peut pas être acheté dans son état actuel. Retirez-le de votre panier pour passer la commande, puis refaites le montage."

#. translators: %s: a slot's label, such as Deck, in brackets after the kit's name.
#: src/Cart/ShowHooks.php:271
#, php-format
msgctxt "the slot a part fills, after its kit"
msgid "(%s)"
msgstr "(%s)"

#: src/Cart/ShowHooks.php:273
msgid "Part of"
msgstr "Fait partie de"

#: src/Cart/ShowHooks.php:301
msgid "Edit build"
msgstr "Modifier le montage"

#. translators: %s: the kit's name, such as Street complete.
#: src/Cart/ShowHooks.php:304
#, php-format
msgid "Edit build: %s"
msgstr "Modifier le montage : %s"

#: src/Cart/ShowHooks.php:344
#: src/Order/OrderHooks.php:233
msgid "not added"
msgstr "non ajouté"

#: src/Cart/ShowHooks.php:346
#: src/Order/OrderHooks.php:234
msgid "free"
msgstr "gratuit"

#. translators: %s: the kit's name, such as Street complete.
#: src/Cart/ShowHooks.php:500
#, php-format
msgid "%s was removed from your cart."
msgstr "Article retiré de votre panier : %s."

#: src/Cart/ShowHooks.php:514
msgid "The line's part in a build: kit, part, or empty for a line of no build."
msgstr "Le rôle de la ligne dans un montage : kit (l’ensemble), part (une pièce), ou vide pour une ligne qui ne fait partie d’aucun montage."

#: src/Cart/ShowHooks.php:515
msgid "The build's identifier."
msgstr "L’identifiant du montage."

#: src/Cart/ShowHooks.php:516
msgid "For a part, its kit's cart item key."
msgstr "Pour une pièce, la clé d’article de panier de son ensemble."

#: src/Cart/ShowHooks.php:517
msgid "For a part, the key of the slot it fills."
msgstr "Pour une pièce, la clé de l’emplacement qu’elle occupe."

#: src/Cart/ShowHooks.php:518
msgid "For a part, its name with its slot's label."
msgstr "Pour une pièce, son nom avec le libellé de son emplacement."

#: src/Cart/ShowHooks.php:519
msgid "For a part, what the cart says when its build is removed."
msgstr "Pour une pièce, ce que le panier affiche quand son montage est retiré."

#. translators: 1: a slot's label, such as Deck; 2: the product's name, which may be a link.
#. translators: 1: a slot's label, such as Bearings. 2: a part's name.
