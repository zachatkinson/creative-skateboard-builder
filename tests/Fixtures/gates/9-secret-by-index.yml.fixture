name: Release
on:
  push:
    tags: ['v*.*.*']
jobs:
  release:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - run: npm ci
      - name: Publish the release
        env:
          GH_TOKEN: ${{ secrets['RELEASES_TOKEN'] }}
        run: gh release create "x" tmp/x.zip
