# On a version tag (v0.1.0), once CI passes on it: build the zip, write its manifest and SBOMs, and publish them to the
# public releases repo that shops check for updates (Updates\Updater, D-003). Needs a RELEASES_TOKEN secret: a
# fine-grained token with Contents read and write on zachatkinson/creative-releases only.
#
# CI is not run again for the tag: the tagged commit is the merge on main, whose push already ran every CI job. A tag
# pushed after that run passed publishes at once; a tag pushed while it runs publishes when it passes (the
# workflow_run trigger); a tag on a commit whose CI failed, or that CI never ran on, fails here and says so.
# Publishing is skipped when the release already exists, so the two triggers never publish twice; a run that finds the
# release but not its info.json (an earlier run stopped between the two) writes info.json from the published zip.
# What a run still has to do is decided by tools/release-plan.sh, which has its own cases (D-048): info.json never
# moves back to an older version, and a zip built by this run always gets its checksum written.
#
# The token and the toolchain never share a runner (D-043). `state` holds the token and runs only gh; `build` installs
# the dev dependencies, builds the zip, the SBOMs, info.json and the release notes with no secret in reach, and hands
# them on as an artifact; `publish` starts on a fresh runner, downloads those files and runs only gh. A package's
# install script that wrote to $GITHUB_ENV or $GITHUB_PATH could otherwise have its code run by the steps that
# publish to the repository every shop's updater trusts.
# Copied from Creative Search, plus the SBOMs (docs/STANDARDS.md: Releases) and this split.
name: Release

on:
  push:
    tags: ['v*.*.*']
  workflow_run:
    workflows: [CI]
    types: [completed]
    branches: [main]

permissions:
  contents: read
  actions: read

# One queue per commit: GitHub keeps one waiting run per queue and cancels the one already waiting when another
# arrives, so a single queue could drop a tag's run behind CI completions on other commits.
concurrency:
  group: release-${{ github.event.workflow_run.head_sha || github.sha }}
  cancel-in-progress: false

jobs:
  ci:
    name: CI passed on the tagged commit
    if: github.event_name == 'push' || (github.event.workflow_run.event == 'push' && github.event.workflow_run.conclusion == 'success')
    runs-on: ubuntu-26.04
    timeout-minutes: 15
    outputs:
      publish: ${{ steps.gate.outputs.publish }}
      sha: ${{ steps.gate.outputs.sha }}
      tag: ${{ steps.gate.outputs.tag }}
    steps:
      - id: gate
        env:
          GH_TOKEN: ${{ github.token }}
          RUN_SHA: ${{ github.event.workflow_run.head_sha }}
        run: |
          set -euo pipefail
          if [ "$GITHUB_EVENT_NAME" = workflow_run ]; then
            sha="$RUN_SHA"
            # Every page of the tags, so the commit's tag is found however many releases there have been.
            tag="$(gh api --paginate "repos/${GITHUB_REPOSITORY}/tags?per_page=100" --jq ".[] | select(.commit.sha == \"${sha}\") | .name | select(test(\"^v[0-9]+[.][0-9]+[.][0-9]+$\"))" | sed -n 1p)"
            if [ -z "$tag" ]; then
              echo "CI passed on ${sha}, which has no version tag yet: its tag's push will publish it."
              echo "publish=false" >> "$GITHUB_OUTPUT"
              exit 0
            fi
          else
            sha="$GITHUB_SHA"
            tag="$GITHUB_REF_NAME"
            run="$(gh api "repos/${GITHUB_REPOSITORY}/actions/workflows/ci.yml/runs?head_sha=${sha}&event=push&branch=main&per_page=1" --jq '.workflow_runs[0] // {} | "\(.status // "none") \(.conclusion // "")"')"
            case "$run" in
              "completed success") ;;
              "none"*)
                echo "::error::CI never ran on ${sha} as a push to main. Tag the merge commit on main, after its CI has run."
                exit 1 ;;
              "completed "*)
                echo "::error::CI on ${sha} ended ${run#completed }. Fix it on main and tag the new commit."
                exit 1 ;;
              *)
                echo "::notice::CI on ${sha} is still running (${run}); ${tag} publishes when it passes."
                echo "publish=false" >> "$GITHUB_OUTPUT"
                exit 0 ;;
            esac
          fi
          printf 'publish=true\nsha=%s\ntag=%s\n' "$sha" "$tag" >> "$GITHUB_OUTPUT"

  # What is already published. A release left as a draft by a run that died while uploading is not published: the
  # publish job removes it and starts again.
  state:
    name: What is already published
    needs: ci
    if: needs.ci.outputs.publish == 'true'
    runs-on: ubuntu-26.04
    timeout-minutes: 5
    env:
      RELEASES_REPO: zachatkinson/creative-releases
      SLUG: creative-skateboard-builder
      TAG: ${{ needs.ci.outputs.tag }}
    outputs:
      version: ${{ steps.state.outputs.version }}
      published: ${{ steps.state.outputs.published }}
      draft: ${{ steps.state.outputs.draft }}
      current: ${{ steps.state.outputs.current }}
    steps:
      # No checkout and no package: this job runs gh and nothing of the repository's.
      - name: Check RELEASES_TOKEN can write to the releases repo
        env:
          GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
        run: |
          test -n "$GH_TOKEN" || { echo "The RELEASES_TOKEN secret is missing."; exit 1; }
          push="$(gh api "repos/${RELEASES_REPO}" --jq .permissions.push)" || { echo "RELEASES_TOKEN can't read ${RELEASES_REPO} (expired, or not given that repo)."; exit 1; }
          test "$push" = "true" || { echo "RELEASES_TOKEN can't write to ${RELEASES_REPO}: give it Contents read and write."; exit 1; }
      - id: state
        env:
          GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
        run: |
          version="${TAG#v}"
          published=no
          draft=no
          is_draft="$(gh release view "${SLUG}-${version}" --repo "$RELEASES_REPO" --json isDraft --jq .isDraft 2>/dev/null || true)"
          if test "$is_draft" = "false"; then
            echo "${SLUG}-${version} is already published."
            published=yes
          fi
          if test "$is_draft" = "true"; then
            echo "${SLUG}-${version} was left as a draft by an earlier run."
            draft=yes
          fi
          current="$(gh api "repos/${RELEASES_REPO}/contents/${SLUG}/info.json" --jq .content 2>/dev/null | base64 -d 2>/dev/null | jq -r '.version // empty' || true)"
          echo "info.json names: ${current}"
          printf 'version=%s\npublished=%s\ndraft=%s\ncurrent=%s\n' "$version" "$published" "$draft" "$current" >> "$GITHUB_OUTPUT"

  # The files a release is made of, built with no secret in the job. It also decides what is left to do.
  build:
    name: Build the zip, the SBOMs and the manifest
    needs: [ci, state]
    runs-on: ubuntu-26.04
    timeout-minutes: 15
    env:
      RELEASES_REPO: zachatkinson/creative-releases
      SLUG: creative-skateboard-builder
      TAG: ${{ needs.ci.outputs.tag }}
      VERSION: ${{ needs.state.outputs.version }}
      PUBLISHED: ${{ needs.state.outputs.published }}
      CURRENT: ${{ needs.state.outputs.current }}
    outputs:
      release: ${{ steps.plan.outputs.release }}
      point: ${{ steps.plan.outputs.point }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
          ref: ${{ needs.ci.outputs.sha }}
      - name: Check the tag matches the plugin version
        run: |
          version="$(grep -E '^ \* Version:' "${SLUG}.php" | awk '{print $3}')"
          test "v${version}" = "${TAG}" || { echo "Tag ${TAG} is not v${version}"; exit 1; }
      - name: What is left to do
        id: plan
        run: |
          bash tools/release-plan.sh "$VERSION" "$PUBLISHED" "$CURRENT" | tee -a "$GITHUB_OUTPUT"
      - uses: shivammathur/setup-php@eb7c497e18156a6bbabfef1d3a82760b9eda3962 # 2.40.0
        if: steps.plan.outputs.release == 'yes' || steps.plan.outputs.point == 'yes'
        with:
          php-version: '8.5'
          tools: composer:v2
          coverage: none
      # The same installs as the CI job that runs the dry run: the script reads the manifest back through the
      # plugin's own class, which needs Composer's autoloader (gate 10).
      - uses: ramsey/composer-install@65e4f84970763564f46a70b8a54b90d033b3bdda # 4.0.0
        if: steps.plan.outputs.release == 'yes'
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7
        if: steps.plan.outputs.release == 'yes'
        with:
          node-version-file: .nvmrc
          cache: npm
      # The zip carries the built assets (build/), so the scripts are installed and built first.
      - run: npm ci
        if: steps.plan.outputs.release == 'yes'
      # The zip, the CycloneDX SBOMs of what it ships (D-003, D-030), info.json read back by the updater's own class,
      # and the release notes: the script CI's release dry run runs, so every line of it has run before a tag meets it.
      - name: Build the release's files
        if: steps.plan.outputs.release == 'yes'
        run: bash tools/release-dry-run.sh
      # An earlier run published the release and stopped before info.json: write it from that zip, which is public.
      - name: The published zip, for info.json
        if: steps.plan.outputs.release != 'yes' && steps.plan.outputs.point == 'yes'
        run: |
          mkdir -p tmp
          curl --fail --silent --show-error --location --output "tmp/${SLUG}-${VERSION}.zip" "https://github.com/${RELEASES_REPO}/releases/download/${SLUG}-${VERSION}/${SLUG}-${VERSION}.zip"
          php tools/release-manifest.php "tmp/${SLUG}-${VERSION}.zip" > tmp/info.json
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        if: steps.plan.outputs.release == 'yes' || steps.plan.outputs.point == 'yes'
        with:
          name: release
          if-no-files-found: error
          retention-days: 1
          path: |
            tmp/${{ env.SLUG }}-${{ env.VERSION }}.zip
            tmp/${{ env.SLUG }}-${{ env.VERSION }}.composer.cdx.json
            tmp/${{ env.SLUG }}-${{ env.VERSION }}.npm.cdx.json
            tmp/info.json
            tmp/release-notes.md

  # A fresh runner: nothing of the repository's or of any package has run on it. It downloads the files and runs gh.
  publish:
    name: Publish to the releases repo
    needs: [state, build]
    if: needs.build.outputs.release == 'yes' || needs.build.outputs.point == 'yes'
    runs-on: ubuntu-26.04
    timeout-minutes: 10
    env:
      RELEASES_REPO: zachatkinson/creative-releases
      SLUG: creative-skateboard-builder
      VERSION: ${{ needs.state.outputs.version }}
      DRAFT: ${{ needs.state.outputs.draft }}
      RELEASE: ${{ needs.build.outputs.release }}
      POINT: ${{ needs.build.outputs.point }}
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8
        with:
          name: release
          path: tmp
      - name: Remove the draft an earlier run left
        if: env.RELEASE == 'yes' && env.DRAFT == 'yes'
        env:
          GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
        run: |
          gh release delete "${SLUG}-${VERSION}" --repo "$RELEASES_REPO" --yes
      - name: Publish the release
        if: env.RELEASE == 'yes'
        env:
          GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
        run: |
          gh release create "${SLUG}-${VERSION}" "tmp/${SLUG}-${VERSION}.zip" "tmp/${SLUG}-${VERSION}.composer.cdx.json" "tmp/${SLUG}-${VERSION}.npm.cdx.json" \
            --repo "$RELEASES_REPO" --title "Creative Skateboard Builder ${VERSION}" --notes-file tmp/release-notes.md
      - name: Point info.json at it
        if: env.POINT == 'yes'
        env:
          GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
        run: |
          path="${SLUG}/info.json"
          sha="$(gh api "repos/${RELEASES_REPO}/contents/${path}" --jq .sha 2>/dev/null || true)"
          gh api --method PUT "repos/${RELEASES_REPO}/contents/${path}" \
            -f message="Creative Skateboard Builder ${VERSION}" \
            -f content="$(base64 -w0 tmp/info.json)" \
            ${sha:+-f sha="$sha"}
