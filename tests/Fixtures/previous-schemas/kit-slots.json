{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "cbuild_slots",
	"description": "A kit's slots, in step order, stored in the _cbuild_slots product meta. The deck's slot comes first and keys are unique; the plugin checks both when it reads the document.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"slots"
	],
	"properties": {
		"schema_version": {
			"description": "The document's version. Version 1 is the only one so far.",
			"type": "integer",
			"enum": [
				1
			]
		},
		"slots": {
			"description": "The slots, in the order the builder steps through them.",
			"type": "array",
			"minItems": 1,
			"maxItems": 20,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"key",
					"label",
					"required",
					"units"
				],
				"properties": {
					"key": {
						"description": "The slot's key. The fit rules read the slots keyed deck, trucks, wheels, risers, bearings, hardware, grip and spacers.",
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]{0,31}(?!\\n)$"
					},
					"label": {
						"description": "The owner's name for the slot.",
						"type": "string",
						"minLength": 1,
						"maxLength": 80
					},
					"help": {
						"description": "Help text shown on the slot's step.",
						"type": "string",
						"maxLength": 300
					},
					"required": {
						"description": "Whether a build must fill the slot.",
						"type": "boolean"
					},
					"units": {
						"description": "Units of a part one build takes: 2 trucks, 4 wheels, 8 bearings.",
						"type": "integer",
						"minimum": 1,
						"maximum": 99
					},
					"sources": {
						"description": "Which products may fill the slot.",
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"categories": {
								"description": "Product category ids.",
								"type": "array",
								"maxItems": 500,
								"items": {
									"type": "integer",
									"minimum": 1
								}
							},
							"brands": {
								"description": "Brand ids.",
								"type": "array",
								"maxItems": 500,
								"items": {
									"type": "integer",
									"minimum": 1
								}
							},
							"products": {
								"description": "Product ids.",
								"type": "array",
								"maxItems": 500,
								"items": {
									"type": "integer",
									"minimum": 1
								}
							},
							"attributes": {
								"description": "Attribute taxonomies, each with the term ids allowed.",
								"type": "array",
								"maxItems": 20,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"taxonomy"
									],
									"properties": {
										"taxonomy": {
											"type": "string",
											"pattern": "^pa_[a-z0-9_-]{1,28}(?!\\n)$"
										},
										"terms": {
											"type": "array",
											"maxItems": 500,
											"items": {
												"type": "integer",
												"minimum": 1
											}
										}
									}
								}
							}
						}
					},
					"default": {
						"description": "The part the slot starts on, or null.",
						"type": [
							"integer",
							"null"
						],
						"minimum": 1
					}
				}
			}
		}
	}
}
