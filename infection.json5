{
	// The plugin outside the domain, at 95 % (D-061; docs/AUDIT.md: Mutation testing). src/Domain has its own 100 % run in
	// infection-domain.json5. Everything in src/ is mutated but the list below, which phpunit.xml.dist's <source> matches.
	"$schema": "vendor/infection/infection/resources/schema.json",
	"source": {
		"directories": [
			"src"
		],
		// A class is left out only when it cannot run without WordPress or WooCommerce loaded: it takes or builds
		// their objects, or does its work through their functions. Each is proven in wp-env by the integration suite,
		// with a deliberate break in its milestone's review. A class whose logic needs no more than the translation
		// functions is mutated here, with the shims in tests/Support/wp-shims.php (D-087).
		"excludes": [
			// Its own run at 100 %: infection-domain.json5.
			"Domain",
			// wp-admin screens: requests, nonces, capabilities, redirects and templates.
			"Admin/SettingsPage.php",
			"Admin/PartSpecsPanel.php",
			"Admin/SpecTablesScreen.php",
			"Admin/ImportScreen.php",
			"Admin/CheckScreen.php",
			"Admin/BuildTab.php",
			// WP-CLI commands, the Abilities API and Site Health: each is a registration and WordPress's own objects.
			"Cli",
			"Abilities",
			"Health/SiteHealth.php",
			// The state route: WordPress's REST request and response, and its locale switcher.
			"Rest/StateRoute.php",
			// Adapters: WooCommerce's products, WordPress's options, posts, uploads, filesystem and the queue.
			"Adapter/ActionSchedulerQueue.php",
			"Adapter/AttributeSpecSource.php",
			"Adapter/DiskFiles.php",
			"Adapter/FieldSpecSource.php",
			"Adapter/KitProduct.php",
			"Adapter/KitSchemas.php",
			"Adapter/OptionImportStore.php",
			"Adapter/OptionReindexStore.php",
			"Adapter/OptionShopSettings.php",
			"Adapter/PostSpecTables.php",
			"Adapter/Products.php",
			"Adapter/RequestUploads.php",
			"Adapter/TableSpecSource.php",
			"Adapter/WooPartCatalogue.php",
			"Adapter/WooPartSpecs.php",
			"Adapter/WooKits.php",
			"Adapter/WooPartCards.php",
			// The object cache and transients, and wc_price().
			"Adapter/CacheTally.php",
			"Adapter/ShopMoney.php",
			"Adapter/WooCommerceLogger.php",
			// The cart and the order (Zach, 11 November 2026, D-137 and D-138): each takes WooCommerce's cart, its
			// products, its coupons, its order items or its shipping packages, and says what a service decided.
			// The deciding is in Service\BuildCart, BuildLines, BuildAgain and OrderBuilds, which are mutated.
			"Cart/AgainHooks.php",
			"Cart/CartHooks.php",
			"Cart/ExpressHooks.php",
			"Cart/LineHooks.php",
			"Cart/PriceHooks.php",
			"Cart/ShipHooks.php",
			"Cart/ShowHooks.php",
			"Order/OrderHooks.php",
			// The workshop's screens (D-YYY): the order's lines through WooCommerce's CRUD, add_meta_box(), the orders
			// lists' hooks, and a nonce and a capability before the ticket prints. Each is proven by BuildBoxTest and
			// TicketTest in wp-env. What they show is decided in Service\OrderReading and Order\WorkshopWords and
			// OrderBoard, which are mutated; TicketPage's ids() and pages() are unit tested but sit beside print().
			"Order/OrderLines.php",
			"Order/WorkshopView.php",
			"Order/BuildBox.php",
			"Order/TicketPage.php",
			"Order/OrdersList.php",
			"Order/WorkshopHooks.php",
			"Adapter/WooCart.php",
			// wp_generate_uuid4(), and the delivery line's two filters with wp_strip_all_tags().
			"Adapter/WpUuids.php",
			"Front/Delivery.php",
			// The builder's page (Zach, 12 November 2026, D-146): the Interactivity API and the template, the block's
			// registration and template_redirect, and wp_validate_redirect(). Each is proven by BuilderPageTest in wp-env.
			// What the builder shows is decided in Front\Builder and BuilderView, which are mutated.
			"Front/BuilderPage.php",
			"Front/PageHooks.php",
			"Front/BuilderUrl.php",
			// get_post(), parse_blocks() and WooCommerce's product type. Which kit a page shows is decided in
			// Front\BuilderPlace, which is mutated (audit 14, milestone 6).
			"Adapter/WpBuilderPosts.php",
			// Robots and the canonical: wp_robots, is_singular() and the queried post; which kit it shows is
			// Front\BuilderPlace's. Proven by
			// BuilderSeoTest and BuilderYoastTest (Zach, 12 November 2026, D-147).
			"Front/SeoHooks.php",
			// SQL through $wpdb, and the classes that only add hooks.
			"Repository",
			"Hooks/",
			"Plugin.php",
			"Hookable.php",
			// Activation, the schema and uninstall: dbDelta, $wpdb and the request WordPress is serving.
			"Install/Activator.php",
			"Install/Deactivator.php",
			"Install/Migrations/InlineRule.php",
			"Install/Schema.php",
			"Install/Uninstaller.php",
			"Install/Migrations/SchemaMigration.php",
			// The update manifest's request and WordPress's update transients.
			"Updates/HttpManifestSource.php",
			"Updates/Updater.php"
		]

	},
	"bootstrap": "tests/bootstrap.php",
	"timeout": 20,
	"logs": {
		"text": "tmp/infection.log",
		"summary": "tmp/infection-summary.log",
		"json": "tmp/infection.json"
	},
	"tmpDir": "tmp/infection",
	"phpUnit": {
		"configDir": "."
	},
	"testFramework": "phpunit",
	"testFrameworkOptions": "--testsuite=unit --exclude-group=benchmark",
	"mutators": {
		"@default": true
	},
	"minMsi": 95,
	"minCoveredMsi": 95
}
