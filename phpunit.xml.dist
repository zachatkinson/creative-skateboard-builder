<?xml version="1.0"?>
<!-- The unit suite: PHPUnit 13, no WordPress. <source> is all of src/, so its report lists every file, tested here
     or not. The domain's floors (tools/coverage-floor.php) read it, and so does the 90 % floor on both suites together
     (tools/coverage-merge.php, D-050), which counts a WordPress-bound class by what the integration suite runs of it. -->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutOutputDuringTests="true"
	failOnRisky="true"
	failOnWarning="true"
	failOnDeprecation="true"
	failOnNotice="true"
	displayDetailsOnTestsThatTriggerDeprecations="true"
	displayDetailsOnTestsThatTriggerNotices="true"
	displayDetailsOnTestsThatTriggerWarnings="true"
	cacheDirectory="tmp/.phpunit.cache"
>
	<php>
		<ini name="memory_limit" value="512M"/>
	</php>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/Unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">src</directory>
		</include>
	</source>
</phpunit>
