<?xml version="1.0"?>
<!-- The unit suite: PHPUnit 13, no WordPress. <source> lists what the unit suite is meant to cover; the floors in
     tools/coverage-floor.php (100 % of src/Domain's lines and branches, 90 % of these lines overall) read it. The
     WordPress-bound classes are proven by the integration suite (phpunit-integration.xml.dist). -->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutOutputDuringTests="true"
	failOnRisky="true"
	failOnWarning="true"
	failOnDeprecation="true"
	failOnNotice="true"
	displayDetailsOnTestsThatTriggerDeprecations="true"
	displayDetailsOnTestsThatTriggerNotices="true"
	displayDetailsOnTestsThatTriggerWarnings="true"
	cacheDirectory="tmp/.phpunit.cache"
>
	<php>
		<ini name="memory_limit" value="512M"/>
	</php>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/Unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">src/Domain</directory>
			<directory suffix=".php">src/Install/Migrations</directory>
			<file>src/Adapter/SystemClock.php</file>
			<file>src/Container.php</file>
			<file>src/Support/Cast.php</file>
			<file>src/Support/Requirements.php</file>
			<file>src/Updates/Manifest.php</file>
		</include>
		<exclude>
			<!-- Runs dbDelta(): the integration suite's (tests/Integration/ActivationTest.php). -->
			<file>src/Install/Migrations/SchemaMigration.php</file>
		</exclude>
	</source>
</phpunit>
